{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*/*": {
      "types": "./src/*/*.ts",
      "default": "./src/*/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "generate": "prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3"
  }
}
