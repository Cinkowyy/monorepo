{
  "name": "@app/trpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./context": {
      "types": "./src/context.ts",
      "import": "./src/context.ts",
      "default": "./src/context.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "import": "./src/router.ts",
      "default": "./src/router.ts"
    },
    "./init": {
      "types": "./src/init.ts",
      "import": "./src/init.ts",
      "default": "./src/init.ts"
    },
    "./routers/*": {
      "types": "./src/routers/*.ts",
      "import": "./src/routers/*.ts",
      "default": "./src/routers/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@trpc/server": "^11.7.1",
    "superjson": "^2.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
