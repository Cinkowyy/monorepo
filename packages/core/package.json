{
  "name": "@app/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./src/types/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.911.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
